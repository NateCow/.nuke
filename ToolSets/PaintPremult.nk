set cut_paste_input [stack 0]
version 10.0 v4
push $cut_paste_input
Group {
 name PaintPremult
 tile_color 0xff005fff
 label "Use rotopaint_mask.a"
 note_font Verdana
 selected true
 xpos -931
 ypos 173
}
 Input {
  inputs 0
  name Input1
  xpos -900
  ypos 54
 }
 FilterErode {
  channels rotopaint_mask
  size -3
  name FilterErode1
  xpos -900
  ypos 94
 }
 Blur {
  channels rotopaint_mask
  size 5
  name Blur1
  xpos -900
  ypos 132
 }
 Shuffle {
  alpha white
  name Shuffle1
  xpos -900
  ypos 170
 }
 Premult {
  channels rgba
  alpha rotopaint_mask.a
  name Premult1
  xpos -900
  ypos 196
 }
 Output {
  name Output1
  xpos -900
  ypos 296
 }
end_group
